# ==========================================
# 数据库配置
# ==========================================
# Supabase Configuration
COZE_SUPABASE_URL=your_supabase_url_here
COZE_SUPABASE_ANON_KEY=your_supabase_anon_key_here
COZE_SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Optional: Database Connection (alternative to Supabase)
DATABASE_URL=postgresql://username:password@localhost:5432/meeting_assistant

# ==========================================
# 安全配置（必填）
# ==========================================
# 会话签名密钥（必填，至少32字符，用于JWT签名）
# 生成命令: openssl rand -base64 32
SESSION_SECRET=change-this-to-a-long-random-string-at-least-32-chars

# 任务确认签名密钥（防止确认链接被篡改）
TASK_CONFIRM_SECRET=change-this-to-a-random-secret-string

# 组织架构自动同步密钥（任意随机字符串）
INTERNAL_SYNC_SECRET=change-this-to-a-random-string

# ==========================================
# CORS配置（可选）
# ==========================================
# 允许的跨域来源，逗号分隔（留空则不限制）
ALLOWED_ORIGINS=https://your-domain.com,https://another-domain.com

# ==========================================
# 泛微OA单点登录配置
# ==========================================
WEAVER_OA_URL=https://your-oa-domain.com
WEAVER_OA_APPID=your_appid_from_ecology_biz_ec
# 以下两项通过调用 POST /api/auth/weaver/register 自动获取
WEAVER_OA_SPK=oa_public_key_after_register
WEAVER_OA_SECRET=encrypted_secret_after_register

# OA数据库链接服务器配置
OA_LINKED_SERVER=FWsv
OA_DATABASE_NAME=ecology

# OA HTTP请求超时（毫秒）
OA_HTTP_TIMEOUT_MS=1500

# 本系统对外访问地址（OA消息里的确认链接用此地址）
NEXT_PUBLIC_APP_URL=https://your-app-domain.com

# OA地址（前端登录页跳转用，和 WEAVER_OA_URL 相同）
NEXT_PUBLIC_OA_URL=https://your-oa-domain.com

# ==========================================
# 文件上传配置
# ==========================================
# 上传文件存储目录（相对于项目根目录）
UPLOAD_DIR=.uploads

# ==========================================
# AI 大模型配置
# ==========================================
# AI_PROVIDER 决定使用哪个平台：siliconflow / tencent / qwen
AI_PROVIDER=tencent

# LLM请求超时（毫秒）
LLM_REQUEST_TIMEOUT_MS=30000

# 硅基流动（SiliconFlow）
SILICONFLOW_API_KEY=your_siliconflow_api_key
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
SILICONFLOW_MODEL=Pro/deepseek-ai/DeepSeek-R1

# 腾讯混元（Tencent Hunyuan / 元宝）
TENCENT_API_KEY=your_tencent_api_key
TENCENT_BASE_URL=https://api.hunyuan.cloud.tencent.com/v1
TENCENT_MODEL=hunyuan-turbo-latest

# 阿里千问（Qwen / DashScope）https://bailian.console.aliyun.com/
QWEN_API_KEY=your_dashscope_api_key
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-max

# ==========================================
# 企业微信配置
# ==========================================
# 企业ID
WECOM_CORPID=your_corp_id

# 通讯录Secret（用于获取成员信息）
WECOM_CONTACTS_SECRET=your_contacts_secret

# 应用ID（用于发送消息）
WECOM_AGENT_ID=1000002

# 测试模式（设置为true时只推送给白名单用户）
WECOM_TEST_MODE=true
WECOM_TEST_WHITELIST=张三,李四
# 百度实时语音识别 https://ai.baidu.com/tech/speech/realtime_asr
BAIDU_ASR_APP_ID=
BAIDU_ASR_API_KEY=
BAIDU_ASR_SECRET_KEY=

# 讯飞实时语音转写 https://www.xfyun.cn/services/rtasr
IFLYTEK_ASR_APPID=
IFLYTEK_ASR_API_KEY=
